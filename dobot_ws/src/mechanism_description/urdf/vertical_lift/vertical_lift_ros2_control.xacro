<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:macro name="prismatic_joint_interface" params="joint_name lower upper initial:=0.0002">
        <joint name="${joint_name}">
            <command_interface name="position">
                <param name="min">${lower}</param>
                <param name="max">${upper}</param>
            </command_interface>
            <state_interface name="position">
                <param name="initial_value">${initial}</param>
            </state_interface>
            <state_interface name="velocity" />
            <state_interface name="effort" />
        </joint>
    </xacro:macro>

    <xacro:macro name="vertical_lift_ros2_control" params="name lower upper">
        <ros2_control name="${name}" type="system">
            <hardware>
                <plugin>gz_ros2_control/GazeboSimSystem</plugin>
            </hardware>
            <xacro:prismatic_joint_interface joint_name="lift_mid_joint" lower="${lower}"
                upper="${upper}" />
            <xacro:prismatic_joint_interface joint_name="lift_top_joint" lower="${lower}"
                upper="${upper}" />
        </ros2_control>
    </xacro:macro>

</robot>